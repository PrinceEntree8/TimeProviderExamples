<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:conv="using:TimeProviderExample.Avalonia.Converters"
        x:Class="TimeProviderExample.Avalonia.MainWindow"
        Title="UDP Time Display" MinWidth="600" MinHeight="400"
        SizeToContent="WidthAndHeight"
        Topmost="True"
        CanResize="True">
  <Window.Resources>
    <x:Double x:Key="DoubleNeg2.0">-2.0</x:Double>
    <x:Double x:Key="DoubleNeg1.0">-1.0</x:Double>
    <x:Double x:Key="DoubleNeg0.5">-0.5</x:Double>
    <x:Double x:Key="Double0.0">0.0</x:Double>
    <x:Double x:Key="Double0.5">0.5</x:Double>
    <x:Double x:Key="Double1.0">1.0</x:Double>
    <x:Double x:Key="Double2.0">2.0</x:Double>
    <x:Double x:Key="Double4.0">4.0</x:Double>
    <x:Double x:Key="Double8.0">8.0</x:Double>
    <conv:DateTimeToDateTimeOffsetConverter x:Key="DateTimeConverter" />
    <conv:InverseBoolConverter x:Key="InverseBoolConverter" />
  </Window.Resources>
  <Window.KeyBindings>
    <KeyBinding Gesture="F2" Command="{Binding SpawnMainWindowCommand}" />
  </Window.KeyBindings>
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="Auto" />
      <ColumnDefinition Width="*" />
    </Grid.ColumnDefinitions>

    <!-- Main row: clock display + sidebar.
         The sidebar is inline (takes a Grid column), so opening it grows the
         auto-sized window instead of squeezing or covering the clock. -->
    <Grid Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>

      <!-- Sidebar -->
      <StackPanel Grid.Column="0" Orientation="Horizontal"
                  Background="{DynamicResource SystemControlPageBackgroundAltHighBrush}">
        <!-- Toggle strip: chevron + label rotate together, chevron flips with state. -->
        <ToggleButton IsChecked="{Binding IsSidebarOpen, Mode=TwoWay}"
                      VerticalAlignment="Stretch" Padding="10,12"
                      Background="Transparent"
                      BorderBrush="{DynamicResource SystemControlForegroundBaseMediumLowBrush}"
                      BorderThickness="0,0,1,0">
          <LayoutTransformControl HorizontalAlignment="Center" VerticalAlignment="Center">
            <LayoutTransformControl.LayoutTransform>
              <RotateTransform Angle="-90" />
            </LayoutTransformControl.LayoutTransform>
            <StackPanel Orientation="Horizontal" Spacing="8">
              <TextBlock Text="&#x00BB;" IsVisible="{Binding IsSidebarOpen, Converter={StaticResource InverseBoolConverter}}" VerticalAlignment="Center" />
              <TextBlock Text="&#x00AB;" IsVisible="{Binding IsSidebarOpen}" VerticalAlignment="Center" />
              <TextBlock Text="Time Control" VerticalAlignment="Center" />
            </StackPanel>
          </LayoutTransformControl>
        </ToggleButton>
        <StackPanel Width="200" Margin="10" VerticalAlignment="Top"
                    IsVisible="{Binding IsSidebarOpen}">
          <TextBlock Text="Time Scale" Margin="0,0,0,5" FontWeight="Bold" />

          <UniformGrid Columns="2" Margin="0,0,0,5">
            <Button Content="x-2" Command="{Binding SetScaleCommand}" CommandParameter="{StaticResource DoubleNeg2.0}" Margin="2" />
            <Button Content="x-1" Command="{Binding SetScaleCommand}" CommandParameter="{StaticResource DoubleNeg1.0}" Margin="2" />
            <Button Content="x-0.5" Command="{Binding SetScaleCommand}" CommandParameter="{StaticResource DoubleNeg0.5}" Margin="2" />
            <Button Content="Freeze (x0)" Command="{Binding SetScaleCommand}" CommandParameter="{StaticResource Double0.0}" Margin="2" />
            <Button Content="x0.5" Command="{Binding SetScaleCommand}" CommandParameter="{StaticResource Double0.5}" Margin="2" />
            <Button Content="x1" Command="{Binding SetScaleCommand}" CommandParameter="{StaticResource Double1.0}" Margin="2" />
            <Button Content="x2" Command="{Binding SetScaleCommand}" CommandParameter="{StaticResource Double2.0}" Margin="2" />
            <Button Content="x4" Command="{Binding SetScaleCommand}" CommandParameter="{StaticResource Double4.0}" Margin="2" />
            <Button Content="x8" Command="{Binding SetScaleCommand}" CommandParameter="{StaticResource Double8.0}" Margin="2" />
          </UniformGrid>

          <Button Content="Restart Play" Command="{Binding RestartPlayCommand}" Margin="2,5,2,20" Padding="5" />

          <DockPanel Margin="0,0,0,20">
            <TextBlock Text="Custom:" VerticalAlignment="Center" Margin="0,0,5,0" />
            <TextBox Text="{Binding Scale, UpdateSourceTrigger=LostFocus}" VerticalAlignment="Center" />
          </DockPanel>

          <TextBlock Text="Set Date &amp; Time" Margin="0,0,0,5" FontWeight="Bold" />
          <DatePicker SelectedDate="{Binding SelectedDate, Converter={StaticResource DateTimeConverter}}" Margin="0,0,0,5" />
          <TextBox Text="{Binding SelectedTime, StringFormat=\{0:hh\\:mm\\:ss\}, UpdateSourceTrigger=LostFocus}" Margin="0,0,0,20" />
        </StackPanel>
      </StackPanel>

      <!-- Main Display -->
      <Grid Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Center">
        <StackPanel>
          <TextBlock Text="{Binding CurrentDate}"
                     FontFamily="Menlo,Consolas,DejaVu Sans Mono"
                     FontSize="36"
                     FontWeight="Bold"
                     HorizontalAlignment="Center"
                     Margin="10" />
          <TextBlock Text="{Binding CurrentTime}"
                     FontFamily="Menlo,Consolas,DejaVu Sans Mono"
                     FontSize="48"
                     FontWeight="Black"
                     HorizontalAlignment="Center"
                     Margin="10" />
        </StackPanel>
      </Grid>
    </Grid>

    <!-- Status Bar (Avalonia has no StatusBar control: Border + DockPanel equivalent) -->
    <Border Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Background="{DynamicResource SystemControlBackgroundBaseLowBrush}" Padding="4">
      <DockPanel>
        <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
          <TextBlock Margin="5,0">
            <Run>System Clock: </Run><Bold><Run Text="{Binding RealTime}" /></Bold>
          </TextBlock>
          <Border Width="1" Margin="5,2" Background="{DynamicResource SystemControlForegroundBaseMediumLowBrush}" />
          <TextBlock Margin="5,0">
            <Run>UDP FPS: </Run><Bold><Run Text="{Binding Fps, StringFormat=N1}" /></Bold>
          </TextBlock>
          <Border Width="1" Margin="5,2" Background="{DynamicResource SystemControlForegroundBaseMediumLowBrush}" />
          <TextBlock Margin="5,0">
            <Run>UI FPS: </Run><Bold><Run Text="{Binding UiFps, StringFormat=N1}" /></Bold>
          </TextBlock>
        </StackPanel>
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
          <TextBlock Margin="5,0">
            <Run>New window </Run><Bold>F2</Bold>
          </TextBlock>
        </StackPanel>
      </DockPanel>
    </Border>
  </Grid>
</Window>
